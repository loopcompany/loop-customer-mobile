{
  "name": "loop-customer-mobile",
  "version": "1.0.0",
  "description": "Loop (لوپ) — Expo/React Native customer app for the Loop home-service platform.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "expo-doctor",
    "verify": "npm run lint && npm run format:check",
    "build:web": "expo export -p web",
    "serve:web": "serve dist -p 3000",
    "deploy:netlify": "cd dist && netlify deploy --prod",
    "deploy:vercel": "cd dist && vercel --prod"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
