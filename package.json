{
  "name": "loop-customer-mobile",
  "version": "1.0.0",
  "description": "Loop (لوپ) — Expo/React Native customer app for the Loop home-service platform.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "expo-doctor",
    "verify": "npm run lint && npm run format:check",
    "build:web": "expo export -p web",
    "serve:web": "serve dist -p 3000",
    "deploy:netlify": "cd dist && netlify deploy --prod",
    "deploy:vercel": "cd dist && vercel --prod"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@kolking/react-native-rating": "^1.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-firebase/app": "26.2.0",
    "@react-native-firebase/messaging": "26.2.0",
    "@react-navigation/bottom-tabs": "^7.5.0",
    "@react-navigation/drawer": "^7.6.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.5.0",
    "@reduxjs/toolkit": "^2.9.2",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.16",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.18",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^10.14.1",
    "i18next": "^25.6.0",
    "jalaali-js": "^1.2.8",
    "moment": "^2.30.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.1.5",
    "react-native": "0.86.3",
    "react-native-bouncy-checkbox": "^3.0.7",
    "react-native-confirmation-code-field": "^8.0.1",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-modern-datepicker": "^1.0.0-beta.91",
    "react-native-otp-verify": "^1.2.0",
    "react-native-qrcode-svg": "^6.3.16",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-otp-verify"
        ]
      }
    }
  }
}
