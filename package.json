    "@react-native-firebase/messaging": "^26.3.3",
    "@react-navigation/bottom-tabs": "^7.5.0",
    "@react-navigation/drawer": "^7.6.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.5.0",
    "@reduxjs/toolkit": "^2.9.2",
    "axios": "^1.12.2",
    "dayjs": "^1.11.18",
