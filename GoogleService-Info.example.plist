<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy this file to GoogleService-Info.plist and replace every value with the
  ones from your Firebase project (Project settings > Your apps > iOS app).
  Also upload an APNs auth key under Project settings > Cloud Messaging.
  The real file is git-ignored (see .gitignore).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>REPLACE_WITH_IOS_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.clpiran.loop</string>
	<key>PROJECT_ID</key>
	<string>REPLACE_PROJECT_ID</string>
	<key>STORAGE_BUCKET</key>
	<string>REPLACE_PROJECT_ID.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:REPLACE_SENDER_ID:ios:REPLACE_HASH</string>
</dict>
</plist>
