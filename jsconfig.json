{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["assets/*"],
      "@components/*": ["components/*"],
      "@contexts/*": ["contexts/*"],
      "@helpers/*": ["helpers/*"],
      "@i18n": ["i18n/index.js"],
      "@hooks/*": ["hooks/*"],
      "@navigation/*": ["navigation/*"],
      "@org/*": ["org/*"],
      "@screens/*": ["screens/*"],
      "@services/*": ["services/*"],
      "@slices/*": ["slices/*"],
      "@store": ["store.js"],
      "@styles/*": ["styles/*"],
      "@theme/*": ["theme/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "exclude": ["node_modules", "dist", "web-build", ".expo", "graphify-out"]
}
